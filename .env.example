# Neon Postgres connection string used by the API routes and Drizzle migrations.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Restricted browser key used to render the Google Map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-browser-key

# Optional canonical site URL used for metadata. This is public configuration, not a secret.
NEXT_PUBLIC_SITE_URL=https://ganapati-bappa-moraya.vercel.app

# Public Vercel Blob store token used for community photo uploads.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Private key used at /admin to review community submissions.
PANDAL_ADMIN_KEY=replace-with-a-long-random-value
